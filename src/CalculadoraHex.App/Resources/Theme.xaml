<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Paleta "calculadora antiga": display verde, moldura cinza-chumbo ===== -->
    <Color x:Key="DisplayBackgroundColor">#1F3D1F</Color>
    <Color x:Key="DisplayForegroundColor">#9AFF9A</Color>
    <Color x:Key="DisplayDimColor">#5C9A5C</Color>
    <Color x:Key="DisplayErrorColor">#FFB347</Color>
    <Color x:Key="BezelColor">#2B2B2B</Color>
    <Color x:Key="BezelLightColor">#3C3C3C</Color>
    <Color x:Key="BezelDarkColor">#1A1A1A</Color>
    <Color x:Key="LabelColor">#C8C8C8</Color>

    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="{StaticResource DisplayBackgroundColor}" />
    <SolidColorBrush x:Key="DisplayForegroundBrush" Color="{StaticResource DisplayForegroundColor}" />
    <SolidColorBrush x:Key="DisplayDimBrush" Color="{StaticResource DisplayDimColor}" />
    <SolidColorBrush x:Key="DisplayErrorBrush" Color="{StaticResource DisplayErrorColor}" />
    <SolidColorBrush x:Key="BezelBrush" Color="{StaticResource BezelColor}" />
    <SolidColorBrush x:Key="BezelLightBrush" Color="{StaticResource BezelLightColor}" />
    <SolidColorBrush x:Key="BezelDarkBrush" Color="{StaticResource BezelDarkColor}" />
    <SolidColorBrush x:Key="LabelBrush" Color="{StaticResource LabelColor}" />

    <!-- Fonte de display: DSEG14 embarcada (14 segmentos, letras A-F e símbolos); fallback monoespaçado. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Resources/Fonts/#DSEG14 Classic, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="LabelFont">Segoe UI</FontFamily>

    <!-- ===== Estilos ===== -->
    <Style x:Key="PaneTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
        <Setter Property="Margin" Value="4,0,0,6" />
    </Style>

    <Style x:Key="DisplayBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DisplayBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BezelDarkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="Foreground" Value="{StaticResource DisplayForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DisplayExpressionStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource DisplayDimBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="DisplayResultStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>

    <Style x:Key="DisplayInputStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource DisplayForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource DisplayForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource DisplayDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CharacterCasing" Value="Normal" />
    </Style>

    <Style x:Key="PromptStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PaneBezelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BezelLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BezelDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
    </Style>

</ResourceDictionary>
