<Window x:Class="CalculadoraHex.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sintaxe e atalhos"
        Width="640" Height="620" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BezelBrush}">

    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Code" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- A janela abre com Show() (não modal), então IsCancel sozinho não fecha: precisa do Click. -->
        <Button DockPanel.Dock="Bottom" Content="_Fechar" IsCancel="True" Click="OnCloseClick" HorizontalAlignment="Right" MinWidth="80" Padding="8,4" Margin="0,10,0,0" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource H}" Margin="0,0,0,6" Text="Linha de entrada" />
                <TextBlock Style="{StaticResource P}" Text="Cada linha é [nome =] expressão. Os dígitos são lidos na base do painel onde você digita; o outro painel mostra a mesma operação na base dele." />
                <Border Style="{StaticResource DisplayBorderStyle}" Padding="10,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Code}" Text="a = 1234            (hexa)  →  a = 4660 no painel decimal" />
                        <TextBlock Style="{StaticResource Code}" Text="a = a * 4321        (hexa)  →  a = 4C5F4B4  |  80082100" />
                        <TextBlock Style="{StaticResource Code}" Text="(255 + 1) / 2       (dec)   →  (0xFF + 1) / 2 = 80 no painel hexa" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H}" Text="Operadores" />
                <TextBlock Style="{StaticResource P}" Text="+  -  *  /  com a precedência usual, parênteses para agrupar e - unário. A divisão é inteira (trunca em direção a zero). Divisão por zero mostra ERRO sem alterar variáveis. Não há limite de tamanho: os números são inteiros de precisão arbitrária." />

                <TextBlock Style="{StaticResource H}" Text="Variáveis" />
                <TextBlock Style="{StaticResource P}" Text="Nome começa por letra ou _ e não diferencia maiúsculas. Uma linha com erro nunca altera variáveis. A barra de status e o menu Variáveis mostram cada valor nas duas bases. Variáveis > Imprimir no display (Ctrl+P) acrescenta ao histórico uma linha por variável, em ordem alfabética, entre linhas separadoras (sem repetir a anterior se já houver uma); essas linhas guardam o valor daquele momento, são gravadas e podem ser apagadas com Ctrl+D." />

                <TextBlock Style="{StaticResource H}" Text="Ambiguidade no painel hexa" />
                <TextBlock Style="{StaticResource P}" Text="Palavras como a, b, cafe são dígitos hexa e também nomes possíveis. Regra: se existe uma variável com esse nome, é variável; senão, é número. O display sublinha o token quando a regra foi aplicada. Para forçar:" />
                <Border Style="{StaticResource DisplayBorderStyle}" Padding="10,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Code}" Text="0xA     1Fh     → sempre número" />
                        <TextBlock Style="{StaticResource Code}" Text="$a      $cafe   → sempre variável" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H}" Text="Sessões" />
                <TextBlock Style="{StaticResource P}" Text="Tudo é gravado automaticamente em %LOCALAPPDATA%\CalculadoraHex\sessoes. Ao abrir, a última sessão volta com histórico e variáveis. Use Arquivo para iniciar outra, abrir uma antiga, salvar com outro nome ou exportar o histórico em texto." />

                <TextBlock Style="{StaticResource H}" Text="Funções especiais" />
                <TextBlock Style="{StaticResource P}" Text="Funções da entrada: sqrt(x) é a raiz quadrada inteira, root(x, n) a raiz n-ésima inteira (n de 1 a 10000) e pow(x, n) a potência. Tudo em inteiros, e a raiz é arredondada para baixo. Os argumentos seguem a base do painel. Especiais > Raiz inteira de uma variável (Ctrl+R) acha o menor inteiro x que, multiplicado por si próprio n vezes, não passa do valor de uma variável. Escolha a variável na lista e informe n, a quantidade de fatores, sempre em decimal: n = 2 é x · x e n = 3 é x · x · x. Resolvida a conta, as linhas são digitadas sozinhas na linha de entrada do painel ativo, uma por vez, como se você fizesse a entrada dos dados, e cada uma mostra o seu resultado antes da próxima. O bloco abre com uma linha tracejada, que não se repete se a última linha do histórico já for uma, e cria três variáveis novas derivadas do nome escolhido: v1_raiz1 (a raiz), v1_result1 (a raiz multiplicada por si própria n vezes) e v1_dif1 (o que sobra de v1; zero se a conta é exata). Cada cálculo leva um número no fim dos três nomes, que o distingue dos demais: o primeiro usa 1 e, se algum desses nomes já existir, o próximo livre (v1_raiz2...), então nada é sobrescrito. Se a variável escolhida já foi criada por uma raiz (por exemplo v1_raiz1), os nomes novos continuam a numeração da origem (v1_raiz2, v1_result2, v1_dif2), e não v1_raiz1_raiz1. Os valores que já estão em variáveis aparecem pelo nome, não pelo número. Cada linha é uma entrada comum do histórico: Ctrl+D apaga uma por vez. Enquanto a digitação roda, a linha de entrada fica travada; Ctrl+N a interrompe. Sem nenhuma variável definida, a função pede que você atribua uma antes. Só vale para valores maiores ou iguais a zero." />
                <Border Style="{StaticResource DisplayBorderStyle}" Padding="10,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Code}" Text="v1 = 288261332929378871" />
                        <TextBlock Style="{StaticResource Code}" Text="#calcula raiz" />
                        <TextBlock Style="{StaticResource Code}" Text="v1_raiz1 = sqrt(v1)" />
                        <TextBlock Style="{StaticResource Code}" HorizontalAlignment="Right" Text="536899741" />
                        <TextBlock Style="{StaticResource Code}" Text="#calcula o resultado" />
                        <TextBlock Style="{StaticResource Code}" Text="v1_result1 = v1_raiz1 * v1_raiz1" />
                        <TextBlock Style="{StaticResource Code}" HorizontalAlignment="Right" Text="288261331885867081" />
                        <TextBlock Style="{StaticResource Code}" Text="#calcula a diferença" />
                        <TextBlock Style="{StaticResource Code}" Text="v1_dif1 = v1 - v1_result1" />
                        <TextBlock Style="{StaticResource Code}" HorizontalAlignment="Right" Text="1043511790" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H}" Text="Comentários" />
                <TextBlock Style="{StaticResource P}" Text="Se a linha digitada começa por #, ela não é calculada: o texto é inserido literalmente, com o #, nos dois painéis. O comentário é gravado na sessão, sai na exportação e pode ser apagado com Ctrl+D como qualquer outra linha. Um # no meio da expressão continua sendo erro." />
                <Border Style="{StaticResource DisplayBorderStyle}" Padding="10,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Code}" Text="#soma de valores" />
                        <TextBlock Style="{StaticResource Code}" Text="a = 1234 + 4321" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H}" Text="Editar o histórico" />
                <TextBlock Style="{StaticResource P}" Text="Editar > Apagar última linha (Ctrl+D) remove a última linha, seja cálculo ou separador, e recalcula as variáveis reavaliando o que sobrou: uma atribuição apagada deixa de valer. Editar > Inserir linha separadora (Ctrl+T) acrescenta uma linha tracejada nos dois painéis, útil para marcar blocos; ela também é gravada e exportada." />

                <TextBlock Style="{StaticResource H}" Text="Importar histórico" />
                <TextBlock Style="{StaticResource P}" Text="Arquivo > Importar histórico acrescenta operações à sessão atual, sem apagar nada. Aceita uma sessão gravada (.json), o texto gerado por Exportar histórico (.txt) ou um script de texto com uma expressão por linha. O texto exportado traz a base de cada linha, então entra sem perguntas. Em scripts escritos à mão, prefixos [hex], [dec], hex: ou dec: fixam a base da linha; sem prefixo vale a base escolhida no diálogo. Linhas iniciadas por # viram comentários no histórico; as iniciadas por ; ou // são ignoradas, e o que vem depois de ; no fim de uma linha é só anotação; uma linha só de traços (---) vira separador; [var] nome = valor recria uma variável impressa." />
                <Border Style="{StaticResource DisplayBorderStyle}" Padding="10,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Code}" Text="# script.txt" />
                        <TextBlock Style="{StaticResource Code}" Text="a = 1234" />
                        <TextBlock Style="{StaticResource Code}" Text="[dec] b = a * 2" />
                        <TextBlock Style="{StaticResource Code}" Text="hex: c = b + FF" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource H}" Text="Atalhos" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Code}" Text="Enter" /><TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource P}" Text="Avalia a linha" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Code}" Text="Esc" /><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource P}" Text="Limpa a linha de entrada" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Code}" Text="Tab" /><TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource P}" Text="Alterna entre o painel hexa e o decimal" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Code}" Text="Ctrl+1 / Ctrl+2" /><TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource P}" Text="Oculta ou exibe o painel hexa / decimal" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Code}" Text="Ctrl+D" /><TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource P}" Text="Apaga a última linha do histórico" />
                    <TextBlock Grid.Row="5" Style="{StaticResource Code}" Text="Ctrl+T" /><TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource P}" Text="Insere uma linha separadora tracejada" />
                    <TextBlock Grid.Row="6" Style="{StaticResource Code}" Text="Ctrl+L" /><TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource P}" Text="Limpa o display (o histórico gravado permanece)" />
                    <TextBlock Grid.Row="7" Style="{StaticResource Code}" Text="Ctrl+N" /><TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource P}" Text="Nova sessão" />
                    <TextBlock Grid.Row="8" Style="{StaticResource Code}" Text="Ctrl+O" /><TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource P}" Text="Abrir sessão" />
                    <TextBlock Grid.Row="9" Style="{StaticResource Code}" Text="Ctrl+Shift+S" /><TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource P}" Text="Salvar sessão como" />
                    <TextBlock Grid.Row="10" Style="{StaticResource Code}" Text="Ctrl+E" /><TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource P}" Text="Exportar histórico em texto" />
                    <TextBlock Grid.Row="11" Style="{StaticResource Code}" Text="Ctrl+I" /><TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource P}" Text="Importar histórico (sessão .json ou script .txt)" />
                    <TextBlock Grid.Row="12" Style="{StaticResource Code}" Text="Ctrl+Shift+V" /><TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource P}" Text="Janela de variáveis" />
                    <TextBlock Grid.Row="13" Style="{StaticResource Code}" Text="Ctrl+P" /><TextBlock Grid.Row="13" Grid.Column="1" Style="{StaticResource P}" Text="Imprime todas as variáveis no display" />
                    <TextBlock Grid.Row="14" Style="{StaticResource Code}" Text="Ctrl+R" /><TextBlock Grid.Row="14" Grid.Column="1" Style="{StaticResource P}" Text="Raiz inteira de uma variável (menu Especiais)" />
                    <TextBlock Grid.Row="15" Style="{StaticResource Code}" Text="F1" /><TextBlock Grid.Row="15" Grid.Column="1" Style="{StaticResource P}" Text="Esta ajuda" />
                    <TextBlock Grid.Row="16" Style="{StaticResource Code}" Text="Alt+F4" /><TextBlock Grid.Row="16" Grid.Column="1" Style="{StaticResource P}" Text="Sair (a sessão já está gravada)" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
