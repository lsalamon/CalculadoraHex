<Window x:Class="CalculadoraHex.App.Views.ImportBaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar histórico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BezelBrush}">

    <StackPanel Margin="14">
        <TextBlock Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" FontSize="13"
                   Text="O arquivo tem uma expressão por linha. Linhas com prefixo [hex], [dec], hex: ou dec: já dizem a base. Como interpretar as linhas sem prefixo?" />

        <StackPanel Margin="4,14,0,10">
            <RadioButton x:Name="HexOption" Content="_Hexadecimal (dígitos 0-9 A-F)" Foreground="{StaticResource LabelBrush}" Margin="0,0,0,8" />
            <RadioButton x:Name="DecOption" Content="_Decimal (dígitos 0-9)" Foreground="{StaticResource LabelBrush}" />
        </StackPanel>

        <Border Style="{StaticResource DisplayBorderStyle}" Padding="10,6" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource DisplayTextStyle}" FontSize="13" Text="# comentário" Foreground="{StaticResource DisplayDimBrush}" />
                <TextBlock Style="{StaticResource DisplayTextStyle}" FontSize="13" Text="a = 1234" />
                <TextBlock Style="{StaticResource DisplayTextStyle}" FontSize="13" Text="[dec] b = a * 2" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Importar" IsDefault="True" Click="OnImportClick" MinWidth="90" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="_Cancelar" IsCancel="True" MinWidth="90" Padding="8,4" />
        </StackPanel>
    </StackPanel>
</Window>
