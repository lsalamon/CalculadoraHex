<UserControl x:Class="CalculadoraHex.App.Views.CalculatorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CalculadoraHex.App.ViewModels"
             xmlns:views="clr-namespace:CalculadoraHex.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PaneViewModel}"
             MinWidth="260">

    <Border Style="{StaticResource PaneBezelStyle}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PaneTitleStyle}" />

            <!-- Linha de entrada -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DisplayBorderStyle}" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&gt;" Style="{StaticResource PromptStyle}" />
                    <TextBox x:Name="InputBox"
                             Style="{StaticResource DisplayInputStyle}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding Hint}"
                             GotKeyboardFocus="OnInputGotFocus">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding ClearInputCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- Display (histórico) -->
            <Border Style="{StaticResource DisplayBorderStyle}">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" KeyboardNavigation.TabNavigation="None">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DisplayLine}">
                                <Grid>
                                    <!-- Comentário: texto literal começando por '#' -->
                                    <TextBlock Text="{Binding CommentText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
                                                <Setter Property="FontSize" Value="16" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="0,2,0,10" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Linha de cálculo: expressão + resultado -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalculation}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock views:SegmentedText.Segments="{Binding Segments}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayExpressionStyle}">
                                                    <Style.Triggers>
                                                        <!-- Impressão de variável: só o resultado, sem a linha da expressão -->
                                                        <DataTrigger Binding="{Binding HasExpression}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Result}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayResultStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DisplayErrorBrush}" />
                                                            <Setter Property="FontSize" Value="16" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Resultado de Especiais > Raiz inteira: título, resultado e, se inexato, o inteiro seguinte -->
                                    <StackPanel Margin="0,2,0,12">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRootResult}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayExpressionStyle}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource DisplayTextStyle}"
                                                   FontSize="20" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Note}" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayExpressionStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNote}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Linha separadora tracejada -->
                                    <!-- Line (um único traço) em vez de Rectangle: as bordas de um retângulo fino sobrepõem os vãos. -->
                                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Height="2" Margin="0,8,0,14"
                                          StrokeThickness="2" StrokeDashArray="4 3" StrokeDashCap="Flat"
                                          Stroke="{StaticResource DisplayDimBrush}" HorizontalAlignment="Stretch">
                                        <Line.Style>
                                            <Style TargetType="Line">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Line.Style>
                                    </Line>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
