<Window x:Class="CalculadoraHex.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CalculadoraHex.App.Views"
        xmlns:vm="clr-namespace:CalculadoraHex.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CalculadoraHex"
        Width="1040" Height="660" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BezelBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewSessionCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenSessionCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveSessionAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ExportHistoryCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="L" Command="{Binding ClearDisplayCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="V" Command="{Binding ShowVariablesCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu superior: agrupado por afinidade; cresce com a app -->
        <Menu DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Nova sessão" Command="{Binding NewSessionCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Abrir sessão..." Command="{Binding OpenSessionCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Salvar _como..." Command="{Binding SaveSessionAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="_Exportar histórico..." Command="{Binding ExportHistoryCommand}" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="Sai_r" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Exibir">
                <MenuItem Header="Painel _Hexadecimal" IsCheckable="True" IsChecked="{Binding HexPane.IsVisible, Mode=TwoWay}" InputGestureText="Ctrl+1" />
                <MenuItem Header="Painel _Decimal" IsCheckable="True" IsChecked="{Binding DecimalPane.IsVisible, Mode=TwoWay}" InputGestureText="Ctrl+2" />
                <Separator />
                <MenuItem Header="_Limpar display" Command="{Binding ClearDisplayCommand}" InputGestureText="Ctrl+L" />
            </MenuItem>
            <MenuItem Header="_Variáveis">
                <MenuItem Header="_Listar / remover..." Command="{Binding ShowVariablesCommand}" InputGestureText="Ctrl+Shift+V" />
                <MenuItem Header="Limpar _todas" Command="{Binding ClearVariablesCommand}" />
            </MenuItem>
            <MenuItem Header="_Operações">
                <MenuItem Header="Soma" InputGestureText="+" IsEnabled="False" />
                <MenuItem Header="Subtração" InputGestureText="-" IsEnabled="False" />
                <MenuItem Header="Multiplicação" InputGestureText="*" IsEnabled="False" />
                <MenuItem Header="Divisão inteira" InputGestureText="/" IsEnabled="False" />
                <MenuItem Header="Agrupamento" InputGestureText="( )" IsEnabled="False" />
                <MenuItem Header="Atribuição" InputGestureText="nome = expr" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="A_juda">
                <MenuItem Header="_Sobre..." Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Barra de status: variáveis nas duas bases + sessão -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BezelDarkBrush}" KeyboardNavigation.TabNavigation="None">
            <StatusBarItem>
                <TextBlock Text="{Binding VariablesSummary}" Style="{StaticResource StatusTextStyle}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}" Margin="0,0,16,0" Opacity="0.8" />
                    <TextBlock Text="{Binding SessionName}" Style="{StaticResource StatusTextStyle}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Dois painéis: Hexa à esquerda, Decimal à direita -->
        <Grid Margin="10" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HexColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="DecimalColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <views:CalculatorPane x:Name="HexPaneView" Grid.Column="0" DataContext="{Binding HexPane}" />

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="8" Margin="2,0" Focusable="False"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BezelDarkBrush}" />

            <views:CalculatorPane x:Name="DecimalPaneView" Grid.Column="2" DataContext="{Binding DecimalPane}" />
        </Grid>
    </DockPanel>
</Window>
